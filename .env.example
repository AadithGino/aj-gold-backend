# Server
PORT=8000
NODE_ENV=development

# MongoDB — transactions require a replica set (Atlas or local replica set)
MONGO_URI=mongodb://127.0.0.1:27017/ajgold_dev?replicaSet=rs0

# Allow npm run reset:demo (requires dev/demo/test in database name)
ALLOW_DATABASE_RESET=false
CONFIRM_DATABASE_RESET=

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=aj-gold-api
JWT_AUDIENCE=aj-gold-clients

# CORS (comma-separated exact origins). Required non-empty in production.
# Leave empty in development to allow all origins (including React Native without Origin header).
CORS_ORIGINS=

# Reverse proxy trust (false, true, loopback, or hop count). Defaults: false in dev, 1 in production.
TRUST_PROXY=

# Request body limit
BODY_SIZE_LIMIT=100kb

# Login rate limiting (MongoDB-backed)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=20
LOGIN_LOCKOUT_MS=900000

# Operations
SHUTDOWN_TIMEOUT_MS=15000
SETTLEMENT_FORMULA_VERSION=principal-v1
LOG_LEVEL=info
BACKUP_DIR=./backups

# Seed scripts (required for seed:admin — never use defaults in production)
DEFAULT_ADMIN_PHONE=
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Admin

# Set to true only when intentionally seeding production
SEED_ALLOW_PRODUCTION=false

# Test database (optional — mongodb-memory-server used by default in npm test)
TEST_MONGO_URI=

# Firebase Cloud Messaging (push notifications)
# Set FCM_ENABLED=true once Firebase service account credentials are configured.
FCM_ENABLED=false
# Allow POST /api/devices/test-push (auto-enabled outside production)
FCM_TEST_PUSH_ENABLED=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Use literal newlines or \\n escapes when setting via env var.
FIREBASE_PRIVATE_KEY=
# Optional alternative to the three FIREBASE_* vars above:
GOOGLE_APPLICATION_CREDENTIALS=
