{
  "name": "backend",
  "version": "1.0.0",
  "description": "AJ Gold Kambil Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=20 <25",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test node --test --test-concurrency=1 test/*.test.js",
    "migrate": "node src/migrations/migrate.js",
    "migrate:dry-run": "node src/migrations/migrate.js --dry-run",
    "migrate:verify": "node src/migrations/migrate.js --verify",
    "verify:indexes": "node scripts/verify-indexes.js",
    "integrity:scan": "node scripts/integrity-scan.js",
    "backup:db": "node scripts/backup-db.js",
    "restore:db": "node scripts/restore-db.js",
    "reset:demo": "node src/seed/resetDemo.js",
    "reset:demo:env": "dotenv -e .env.demo -- npm run reset:demo",
    "start:demo": "dotenv -e .env.demo -- node server.js",
    "smoke:integration": "dotenv -e .env.demo -- node src/seed/integrationSmoke.js",
    "env:demo": "node scripts/createDemoEnv.js",
    "seed:admin": "node src/seed/seedAdmin.js",
    "seed:demo": "node src/seed/seedDemo.js",
    "seed:cash-vault-demo": "node src/seed/seedCashVaultDemo.js",
    "smoke:phase2": "node src/seed/smokePhase2.js",
    "smoke:phase3": "node src/seed/smokePhase3.js",
    "smoke:phase4": "node src/seed/smokePhase4.js",
    "smoke:phase5": "node src/seed/smokePhase5.js",
    "smoke:phase6": "node src/seed/smokePhase6.js",
    "smoke:phase7": "node src/seed/smokePhase7.js",
    "smoke:phase8": "node src/seed/smokePhase8.js",
    "ci": "npm ci --ignore-scripts && npm test && npm run migrate:verify && npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "morgan": "^1.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.14"
  }
}
